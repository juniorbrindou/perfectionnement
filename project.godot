; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Perfectionnement"
config/version="0.6.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icone/icone_512.png"
boot_splash/bg_color=Color(0.012, 0.063, 0.165, 1)
boot_splash/image="res://assets/logo/demarrage.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/quit_on_go_back=false

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
Online="*res://scripts/online.gd"
Session="*res://scripts/session.gd"
DevTools="*res://scripts/dev_tools.gd"
Keyboard="*res://scripts/keyboard_avoider.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[editor_plugins]

enabled=PackedStringArray("res://addons/google_sign_in/plugin.cfg")
